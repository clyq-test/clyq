// @ts-nocheck
'use client'
import { useState } from 'react'

const brandProducts = [
  { brand:'MARCIA', id:'MA-2026-CT-001', name:'오버핏 캐시미어 울 코트', category:'아우터 > 코트', price:298000, season:'2026 F/W', sizes:['S','M','L'] },
  { brand:'MARCIA', id:'MA-2026-ST-003', name:'울 블레이저 세트업', category:'원피스·세트 > 세트업', price:389000, season:'2026 F/W', sizes:['S','M'] },
  { brand:'MARCIA', id:'MA-2026-KN-012', name:'캐시미어 니트', category:'상의 > 니트', price:178000, season:'2026 F/W', sizes:['S','M','L','XL'] },
  { brand:'MATIN KIM', id:'MK-2026-JK-001', name:'레더 재킷', category:'아우터 > 재킷', price:456000, season:'2026 F/W', sizes:['S','M','L'] },
  { brand:'MATIN KIM', id:'MK-2026-BL-004', name:'실크 블라우스', category:'상의 > 블라우스', price:148000, season:'2026 S/S', sizes:['S','M'] },
  { brand:'EENK', id:'EK-2026-CT-002', name:'더블 브레스트 코트', category:'아우터 > 코트', price:528000, season:'2026 F/W', sizes:['S','M','L'] },
  { brand:'D.POUND', id:'DP-2026-PA-001', name:'와이드 팬츠', category:'하의 > 팬츠', price:198000, season:'2026 F/W', sizes:['S','M','L'] },
]

const acquisitionTypes = ['브랜드 제공 (무상)','브랜드 제공 (임차)','CLYQ 직접 구매']
const conditionTypes   = ['새 제품','전시 제품','샘플 제품']
const brands           = ['MARCIA','MATIN KIM','EENK','D.POUND','ANDERSSONBELL','ANOTHER A','EIGHT','ADER ERROR']

export default function FittingProductNewPage() {
  const [form, setForm] = useState({
    brand:'', productId:'', acquisitionType:'브랜드 제공 (무상)',
    condition:'새 제품', acquisitionDate:'', quantity:'1',
    sizes:[], penaltyBase:'', fittingPeriod:'3', multiSize:true,
    storageLocation:'', internalNote:'', fittingNote:'',
  })
  const [saved, setSaved] = useState(false)
  const [searchText, setSearchText] = useState('')

  function f(key, val) { setForm(p => ({...p, [key]:val})) }

  const filteredProducts = brandProducts.filter(p => {
    const matchBrand = !form.brand || p.brand === form.brand
    const matchSearch = !searchText || p.name.includes(searchText) || p.id.includes(searchText)
    return matchBrand && matchSearch
  })

  const selectedProduct = brandProducts.find(p => p.id === form.productId)

  function toggleSize(s) {
    const next = form.sizes.includes(s)
      ? form.sizes.filter(x => x !== s)
      : [...form.sizes, s]
    f('sizes', next)
  }

  const inputS = { padding:'8px 12px', border:'1px solid #d0d0d8', borderRadius:'4px', fontSize:'13px', outline:'none', fontFamily:'inherit', background:'#fff', width:'100%' }
  const selectS = { ...inputS, cursor:'pointer' }
  const rowS = { display:'grid', gridTemplateColumns:'160px 1fr', borderBottom:'1px solid #f0f0f2', alignItems:'start' }
  const labelS = { padding:'13px 16px', fontSize:'12px', color:'#555', fontWeight:600, background:'#fafafa', borderRight:'1px solid #f0f0f2', display:'flex', alignItems:'center', minHeight:'46px' }
  const cellS = { padding:'10px 16px', display:'flex', alignItems:'center', gap:'8px', flexWrap:'wrap' }
  const req = <span style={{ color:'#dc2626', marginLeft:'2px' }}>*</span>

  return (
    <>
      <style>{`
        .fnp-section { background:#fff; border:1px solid #e8e8eb; border-radius:8px; margin-bottom:16px; overflow:hidden; }
        .fnp-sec-head { padding:13px 20px; background:#0f1623; color:#fff; font-size:13px; font-weight:700; }
        .fnp-prod-list { max-height:260px; overflow-y:auto; border:1px solid #e8e8eb; border-radius:6px; }
        .fnp-prod-row { padding:11px 14px; border-bottom:1px solid #f5f5f7; cursor:pointer; display:flex; align-items:center; justify-content:space-between; }
        .fnp-prod-row:last-child { border-bottom:none; }
        .fnp-prod-row:hover { background:#fff8f5; }
        .fnp-prod-row.sel { background:#fff3ee; border-left:3px solid #C94E1A; }
        .fnp-size-tag { display:flex; align-items:center; gap:3px; padding:5px 10px; border-radius:4px; font-size:12px; font-weight:500; cursor:pointer; border:1px solid #d0d0d8; background:#fff; transition:all 0.15s; }
        .fnp-size-tag.on { background:#C94E1A; border-color:#C94E1A; color:#fff; }
        .fnp-toggle { width:40px; height:22px; border-radius:11px; border:none; cursor:pointer; position:relative; transition:background 0.2s; flex-shrink:0; }
        .fnp-btn-save { padding:11px 32px; background:#C94E1A; color:#fff; border:none; border-radius:5px; font-size:14px; font-weight:700; cursor:pointer; font-family:inherit; }
        .fnp-btn-save:hover { background:#a83d14; }
        .fnp-btn-out { padding:11px 20px; background:#fff; color:#555; border:1px solid #d0d0d8; border-radius:5px; font-size:13px; cursor:pointer; font-family:inherit; }
        .fnp-success { background:#10b981; color:#fff; padding:13px 18px; border-radius:8px; font-size:14px; font-weight:600; margin-bottom:16px; }
        input:focus, select:focus, textarea:focus { border-color:#C94E1A !important; }
      `}</style>

      {/* 헤더 */}
      <div style={{ display:'flex', alignItems:'flex-end', justifyContent:'space-between', marginBottom:'20px', flexWrap:'wrap', gap:'10px' }}>
        <div>
          <div style={{ fontSize:'11px', color:'#aaa', marginBottom:'4px' }}>피팅박스 관리 › 피팅 제품 등록</div>
          <h1 style={{ fontSize:'22px', fontWeight:800, color:'#1a1a2e', margin:0 }}>피팅 제품 등록</h1>
          <div style={{ fontSize:'12px', color:'#aaa', marginTop:'4px' }}>브랜드 등록 상품에서 선택 후 피팅 전용 설정을 추가합니다.</div>
        </div>
        <div style={{ display:'flex', gap:'8px' }}>
          <button className="fnp-btn-out" onClick={() => history.back()}>취소</button>
          <button className="fnp-btn-save" onClick={() => { setSaved(true); setTimeout(() => setSaved(false), 3000); window.scrollTo({top:0,behavior:'smooth'}) }}>
            등록하기
          </button>
        </div>
      </div>

      {saved && <div className="fnp-success">피팅 제품이 등록됐어요.</div>}

      {/* ① 브랜드 선택 */}
      <div className="fnp-section">
        <div className="fnp-sec-head">① 브랜드 선택</div>
        <div style={rowS}>
          <div style={labelS}>브랜드{req}</div>
          <div style={cellS}>
            <select style={{...selectS, maxWidth:'240px'}} value={form.brand} onChange={e => { f('brand', e.target.value); f('productId','') }}>
              <option value="">브랜드 선택</option>
              {brands.map(b => <option key={b}>{b}</option>)}
            </select>
          </div>
        </div>
      </div>

      {/* ② 상품 선택 */}
      <div className="fnp-section">
        <div className="fnp-sec-head">② 브랜드 등록 상품에서 선택</div>
        <div style={{ padding:'16px 20px' }}>
          <input
            style={{...inputS, maxWidth:'320px', marginBottom:'12px'}}
            type="text"
            placeholder="상품명 또는 상품코드 검색"
            value={searchText}
            onChange={e => setSearchText(e.target.value)}
          />
          <div className="fnp-prod-list">
            {filteredProducts.length === 0 ? (
              <div style={{ padding:'24px', textAlign:'center', color:'#aaa', fontSize:'13px' }}>
                {form.brand ? '등록된 상품이 없습니다.' : '브랜드를 먼저 선택하세요.'}
              </div>
            ) : filteredProducts.map(p => (
              <div
                key={p.id}
                className={form.productId === p.id ? 'fnp-prod-row sel' : 'fnp-prod-row'}
                onClick={() => { f('productId', p.id); f('brand', p.brand); f('sizes', p.sizes); f('penaltyBase', String(p.price)) }}
              >
                <div>
                  <div style={{ fontWeight:600, color:'#1a1a2e', fontSize:'13px' }}>{p.name}</div>
                  <div style={{ fontSize:'11px', color:'#aaa', marginTop:'2px' }}>{p.id} · {p.brand} · {p.category} · {p.season}</div>
                </div>
                <div style={{ fontSize:'13px', fontWeight:700, color:'#C94E1A', flexShrink:0 }}>
                  {p.price.toLocaleString()}원
                </div>
              </div>
            ))}
          </div>
          {selectedProduct && (
            <div style={{ marginTop:'12px', padding:'12px 16px', background:'#f0fdf4', border:'1px solid #bbf7d0', borderRadius:'6px', fontSize:'12px', color:'#16a34a', fontWeight:600 }}>
              선택됨: {selectedProduct.name} ({selectedProduct.id})
            </div>
          )}
        </div>
      </div>

      {/* ③ 피팅 수량 / 사이즈 */}
      <div className="fnp-section">
        <div className="fnp-sec-head">③ 피팅 재고 설정</div>
        <div style={rowS}>
          <div style={labelS}>보유 수량{req}</div>
          <div style={cellS}>
            <input style={{...inputS, maxWidth:'100px'}} type="number" value={form.quantity} onChange={e => f('quantity', e.target.value)}/>
            <span style={{ fontSize:'12px', color:'#888' }}>개</span>
          </div>
        </div>
        <div style={rowS}>
          <div style={labelS}>피팅 사이즈{req}</div>
          <div style={cellS}>
            {(selectedProduct ? selectedProduct.sizes : ['XS','S','M','L','XL','XXL','FREE']).map(s => (
              <div
                key={s}
                className={form.sizes.includes(s) ? 'fnp-size-tag on' : 'fnp-size-tag'}
                onClick={() => toggleSize(s)}
              >
                {s}
              </div>
            ))}
          </div>
        </div>
        <div style={rowS}>
          <div style={labelS}>보관 위치</div>
          <div style={cellS}>
            <input style={{...inputS, maxWidth:'280px'}} type="text" placeholder="예: 물류센터 A-3-12" value={form.storageLocation} onChange={e => f('storageLocation', e.target.value)}/>
          </div>
        </div>
      </div>

      {/* ④ 피팅 규정 */}
      <div className="fnp-section">
        <div className="fnp-sec-head">④ 피팅 규정 설정</div>
        <div style={rowS}>
          <div style={labelS}>피팅 기간{req}</div>
          <div style={cellS}>
            <select style={{...selectS, maxWidth:'160px'}} value={form.fittingPeriod} onChange={e => f('fittingPeriod', e.target.value)}>
              {['2','3','5','7'].map(d => <option key={d} value={d}>{d}일 (수령일 포함)</option>)}
            </select>
          </div>
        </div>
        <div style={rowS}>
          <div style={labelS}>복수 사이즈 신청</div>
          <div style={cellS}>
            <button
              className="fnp-toggle"
              style={{ background: form.multiSize ? '#C94E1A' : '#d0d0d8' }}
              onClick={() => f('multiSize', !form.multiSize)}
            >
              <span style={{ position:'absolute', left: form.multiSize ? '20px' : '2px', top:'2px', width:'18px', height:'18px', borderRadius:'50%', background:'#fff', boxShadow:'0 1px 3px rgba(0,0,0,.2)', transition:'left 0.2s' }}/>
            </button>
            <span style={{ fontSize:'13px', color: form.multiSize ? '#C94E1A' : '#999' }}>
              {form.multiSize ? '최대 2가지 사이즈 동시 신청 허용' : '1가지 사이즈만 신청 가능'}
            </span>
          </div>
        </div>
        <div style={rowS}>
          <div style={labelS}>배상 기준가{req}</div>
          <div style={cellS}>
            <input style={{...inputS, maxWidth:'160px', textAlign:'right'}} type="text" placeholder="0" value={form.penaltyBase} onChange={e => f('penaltyBase', e.target.value)}/>
            <span style={{ fontSize:'12px', color:'#888' }}>원 (훼손 시 배상 기준)</span>
          </div>
        </div>
        <div style={rowS}>
          <div style={labelS}>피팅 주의사항</div>
          <div style={{ padding:'10px 16px', flex:1 }}>
            <textarea
              style={{...inputS, height:'72px', resize:'vertical', lineHeight:'1.6'}}
              placeholder="예: 드라이클리닝 전용 소재. 향수 직접 접촉 주의."
              value={form.fittingNote}
              onChange={e => f('fittingNote', e.target.value)}
            />
          </div>
        </div>
      </div>

      {/* ⑤ 입수 정보 */}
      <div className="fnp-section">
        <div className="fnp-sec-head">⑤ 입수 정보 (내부용)</div>
        <div style={rowS}>
          <div style={labelS}>입수 유형{req}</div>
          <div style={cellS}>
            <select style={{...selectS, maxWidth:'240px'}} value={form.acquisitionType} onChange={e => f('acquisitionType', e.target.value)}>
              {acquisitionTypes.map(t => <option key={t}>{t}</option>)}
            </select>
          </div>
        </div>
        <div style={rowS}>
          <div style={labelS}>제품 상태</div>
          <div style={cellS}>
            {conditionTypes.map(c => (
              <label key={c} style={{ display:'flex', alignItems:'center', gap:'6px', cursor:'pointer', fontSize:'13px', color:'#333' }}>
                <input type="radio" name="condition" checked={form.condition === c} onChange={() => f('condition', c)} style={{ accentColor:'#C94E1A' }}/>
                {c}
              </label>
            ))}
          </div>
        </div>
        <div style={rowS}>
          <div style={labelS}>입수일</div>
          <div style={cellS}>
            <input style={{...inputS, maxWidth:'180px'}} type="date" value={form.acquisitionDate} onChange={e => f('acquisitionDate', e.target.value)}/>
          </div>
        </div>
        <div style={{...rowS, borderBottom:'none'}}>
          <div style={labelS}>내부 메모</div>
          <div style={{ padding:'10px 16px', flex:1 }}>
            <textarea
              style={{...inputS, height:'72px', resize:'vertical', lineHeight:'1.6'}}
              placeholder="입수 경위, 특이사항 등 내부 메모 (브랜드 비공개)"
              value={form.internalNote}
              onChange={e => f('internalNote', e.target.value)}
            />
            <div style={{ fontSize:'11px', color:'#C94E1A', marginTop:'4px' }}>브랜드 파트너에게 공개되지 않습니다.</div>
          </div>
        </div>
      </div>

      {/* 하단 버튼 */}
      <div style={{ display:'flex', justifyContent:'center', gap:'10px', padding:'24px 0' }}>
        <button className="fnp-btn-out" onClick={() => history.back()}>취소</button>
        <button className="fnp-btn-save" onClick={() => { setSaved(true); setTimeout(() => setSaved(false), 3000); window.scrollTo({top:0,behavior:'smooth'}) }}>
          피팅 제품 등록하기
        </button>
      </div>
    </>
  )
}
